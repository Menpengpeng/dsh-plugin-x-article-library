{
  "name": "@menpengpeng/dsh-plugin-x-article-library",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "DSH plugin: save public X (Twitter) posts as offline Markdown with a three-pane library reader.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "x",
    "twitter",
    "markdown",
    "readlater"
  ],
  "license": "MIT",
  "author": "menpengpeng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Menpengpeng/dsh-plugin-x-article-library.git"
  },
  "bugs": {
    "url": "https://github.com/Menpengpeng/dsh-plugin-x-article-library/issues"
  },
  "homepage": "https://github.com/Menpengpeng/dsh-plugin-x-article-library#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
